{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLCReviewFindings",
  "type": "object",
  "required": ["reviewer_role", "verdict", "round", "findings"],
  "properties": {
    "reviewer_role": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "PUSHBACK", "ESCALATE"]
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "severity", "description", "required_remediation"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW", "INFO"]
          },
          "target_file": { "type": "string" },
          "line_range": { "type": "string" },
          "description": { "type": "string" },
          "required_remediation": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "scope_coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["implemented"],
        "properties": {
          "implemented": { "type": "boolean" },
          "evidence_files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "markdown_digest": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
