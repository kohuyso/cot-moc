{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLCSAReviewFindings",
  "type": "object",
  "required": ["reviewer_role", "verdict", "round", "findings"],
  "properties": {
    "reviewer_role": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "PUSHBACK", "ESCALATE"]
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "severity", "description", "required_remediation"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW", "INFO"]
          },
          "target_file": { "type": "string" },
          "line_range": { "type": "string" },
          "evidence_ref": { "type": "string" },
          "description": { "type": "string" },
          "required_remediation": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "sample_verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "result", "spec_ref", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "result": { "type": "string", "enum": ["COVERED", "PARTIAL", "MISSING"] },
          "spec_ref": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "markdown_digest": {
      "type": "string"
    },
    "user_intent_verified": {
      "type": "boolean"
    },
    "unresolved_questions_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
