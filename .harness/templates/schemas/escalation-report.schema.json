{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLCEscalationReport",
  "type": "object",
  "required": [
    "run_id",
    "loop",
    "trigger_reason",
    "findings",
    "options",
    "recommended_action"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "loop": {
      "type": "string",
      "enum": ["BA_SA", "DEV_REVIEW", "TEST_QA", "SECURITY_REVIEW", "UI_REVIEW", "TECH_REVIEW", "TEST_DESIGN_REVIEW"]
    },
    "trigger_reason": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "minItems": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    },
    "recommended_action": {
      "type": "string"
    },
    "markdown_digest": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
