{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLCPlanVerificationAndRedTeam",
  "type": "object",
  "required": [
    "run_id",
    "plan_digest",
    "verdict",
    "target_files",
    "claims",
    "red_team_findings",
    "consistency_sweep"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "plan_digest": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": ["VERIFIED", "BLOCKED"]
    },
    "target_files": {
      "type": "object",
      "required": ["create", "modify", "test"],
      "properties": {
        "create": {
          "type": "array",
          "items": { "type": "string" }
        },
        "modify": {
          "type": "array",
          "items": { "type": "string" }
        },
        "delete": {
          "type": "array",
          "items": { "type": "string" }
        },
        "test": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "claim", "status", "evidence_ref"],
        "properties": {
          "id": { "type": "string" },
          "role": {
            "type": "string",
            "enum": [
              "FACT_CHECKER",
              "FLOW_TRACER",
              "SCOPE_AUDITOR",
              "CONTRACT_VERIFIER"
            ]
          },
          "claim": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["VERIFIED", "FAILED"]
          },
          "evidence_ref": { "type": "string" },
          "symbol": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "red_team_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "lens",
          "severity",
          "description",
          "evidence_ref",
          "disposition",
          "resolution"
        ],
        "properties": {
          "id": { "type": "string" },
          "lens": {
            "type": "string",
            "enum": [
              "SECURITY_ADVERSARY",
              "ASSUMPTION_DESTROYER",
              "FAILURE_MODE_ANALYST",
              "SCOPE_CRITIC"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "description": { "type": "string" },
          "evidence_ref": { "type": "string" },
          "disposition": {
            "type": "string",
            "enum": ["ACCEPTED", "REJECTED"]
          },
          "resolution": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "consistency_sweep": {
      "type": "object",
      "required": ["decision_deltas", "unresolved_contradictions"],
      "properties": {
        "decision_deltas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["section", "before", "after"],
            "properties": {
              "section": { "type": "string" },
              "before": { "type": "string" },
              "after": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "unresolved_contradictions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
