{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDLCWorkItems",
  "type": "object",
  "required": [
    "slice_id",
    "items"
  ],
  "properties": {
    "slice_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "assigned_role",
          "fr_refs",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "api",
              "db",
              "ui",
              "logic",
              "test",
              "security"
            ]
          },
          "assigned_role": {
            "type": "string"
          },
          "fr_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "ac_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Artifact file names (inside artifacts/) the item's review reads; unchanged inputs let an earlier APPROVE be reused"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
